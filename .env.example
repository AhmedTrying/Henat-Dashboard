# Public — sent to the browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Neon Postgres connection string
# (see https://neon.tech → Project → Connection Details → Pooled connection)
# Without this, the app serves the built-in demo snapshot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Server-only — never expose to the browser
GEMINI_API_KEY=replace-with-rotated-gemini-key

# Cron secret. Set ONE of these on Vercel:
#   CRON_SECRET         → preferred. Vercel Cron automatically sends
#                          `Authorization: Bearer $CRON_SECRET` to the
#                          endpoint when this is configured.
#   INGEST_CRON_SECRET  → backward-compatible fallback if CRON_SECRET is
#                          not set. The route checks CRON_SECRET first.
CRON_SECRET=generate-a-random-string
# INGEST_CRON_SECRET=fallback-only-if-needed

# Optional
GEMINI_MODEL=gemini-2.5-pro
